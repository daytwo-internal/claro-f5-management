fields:
  - id: f5_certificate_pem
    type: string
    label: Certificate PEM
    multiline: true

  - id: f5_private_key_pem
    type: string
    label: Private Key PEM
    multiline: true
    secret: true

  - id: f5_private_key_passphrase
    type: string
    label: Private Key Passphrase
    secret: true

required:
  - f5_certificate_pem
  - f5_private_key_pem

---injector------------------

extra_vars:
  f5_certificate_pem: '{{ f5_certificate_pem }}'
  f5_private_key_pem: '{{ f5_private_key_pem }}'
  f5_private_key_passphrase: '{{ f5_private_key_passphrase }}'

